# User service for the Bothy agent. Install (no root needed):
#   mkdir -p ~/.config/systemd/user && cp bothy-agent.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now bothy-agent
#   loginctl enable-linger "$USER"     # keep it running after logout
# Edit the paths below if you put the agent elsewhere.
[Unit]
Description=Bothy agent: missions from the phone, telemetry back
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/bothy-agent/agent.py run --folder robot
Environment=PYTHONPATH=%h/bothy-agent/site
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
